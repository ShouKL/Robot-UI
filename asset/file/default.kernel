robot_ui_kernel:
  version: 1
  style:
    theme: 6
    invert: false
    alpha: 1
  ui_state:
    about_open: false
    option_open: false
    simulation_open: false
    live_streamer_open: false
    robot_status_open: true
    node_editor_open: false
    thrust_curve_editor_open: false
    robot_comm_open: true
    notification_open: true
    terminal_open: true
    monitor_wall_open: false
    robot_active_mode: 0
    gamepad_active_mode: 0
    node_left_side_width: 180
    node_right_side_width: 200
    robot_path: ..\..\..\asset\file\demo.rbt
    robot_dirty: false
    recent_files:
      - ..\..\..\asset\file\demo.rbt
      - ..\..\..\asset\file\default.rbt