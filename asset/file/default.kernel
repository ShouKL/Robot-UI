robot_ui_kernel:
  version: 1
  style:
    theme: 6
    invert: false
    alpha: 1
  ui_state:
    about_open: false
    option_open: true
    simulation_open: false
    live_streamer_open: false
    robot_status_open: true
    node_editor_open: false
    thrust_curve_editor_open: false
    robot_comm_open: false
    notification_open: true
    terminal_open: true
    monitor_wall_open: true
    robot_active_mode: 1
    gamepad_active_mode: 0
    node_left_side_width: 200
    node_right_side_width: 200
    robot_path: ..\..\..\asset\file\demo.rbt
    robot_dirty: false
    recent_files:
      - ..\..\..\asset\file\demo.rbt
      - ..\..\..\asset\file\default.rbt
    screenshot_scope: 5
    screenshot_path: ""
    conn_retry_count: 5
    camera_retry_count: 2
  software_shortcuts:
    File Open: {key: 560, ctrl: true, shift: false, alt: false}
    File Save: {key: 564, ctrl: true, shift: false, alt: false}
    File Save As: {key: 564, ctrl: true, shift: true, alt: false}
    Toggle Option Panel: {key: 562, ctrl: true, shift: false, alt: false}
    Toggle Status Panel: {key: 557, ctrl: true, shift: false, alt: false}
    Toggle Robot Setting Panel: {key: 550, ctrl: true, shift: false, alt: false}
    Toggle Terminal Panel: {key: 566, ctrl: true, shift: false, alt: false}
    Toggle Monitor Wall: {key: 551, ctrl: true, shift: false, alt: false}
    Toggle Thrust Curve Editor: {key: 554, ctrl: true, shift: false, alt: false}
    Toggle About: {key: 546, ctrl: true, shift: true, alt: false}
    Screenshot: {key: 569, ctrl: true, shift: true, alt: false}