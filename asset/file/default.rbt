robot_ui_config:
  version: 1
  robot:
    items:
      - name: Item_1
        gamepad_mapping: ""
        host_ip: ""
        remote_port: 0
        local_port: 0
        protocol_type: 0
        has_motion: false
        has_temperature: false
        has_humidity: false
        has_depth: false
        brushless_motors:
          []
        servos:
          []
        node_graph: |
          nodes:
            []
          links:
            []
        node_graph_pairs:
          "": |
            nodes:
              []
            links:
              []
        protocol_send:
          include_length: true
          checksum: 1
          header:
            []
          tail:
            []
          fields:
            []
        protocol_receive:
          include_length: true
          checksum: 1
          msg_type: 0
          header:
            []
          tail:
            []
          fields:
            []
    active_mode: 0
  gamepad:
    items:
      - name: Item_1
        gamepad_type: 0
        keys:
          []
        mappings:
          []
    active_mode: 0
  streams:
    - name: Item_1
      ip: 0.0.0.0
      user: ""
      pass: ""
      port: 0
      brand: 2
      channel: 1
      codec: 0
      stream_type: 0
      protocol: 0
      custom_path: ""
      latency: 0
      udp_buffer_size: 0
      timeout: 5000000
      drop_on_latency: true
      ntp_sync: false
      buffer_mode: 0
      decoder: 0
      cpu_threads: 0
      sync_to_clock: false
      max_buffers: 0
      low_latency_mode: true
      use_bgra: false
      auto_hardware_fallback: true
  thrust_curve_editor:
    pwm_min: 0
    pwm_max: 0
    default_pwm: 500
    np_mid: 0
    np_ini: 0
    pp_ini: 0
    pp_mid: 0
    nt_end: 0
    nt_mid: 0
    pt_mid: 0
    pt_end: 0
  robot_comm:
    nodes:
      - name: Item_1
        host_ip: 192.168.0.10
        remote_port: 8888
        local_port: 8888
        transport_type: 0